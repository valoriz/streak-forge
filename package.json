{
  "name": "streak-forge-monorepo",
  "version": "1.0.0",
  "description": "Streak.js framework: streak-forge core, create-streak-app CLI scaffolder, and docs site",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/streak-forge && npm run build -w packages/create-streak-app && npm run build -w apps/docs-site",
    "build:streak-forge": "npm run build -w packages/streak-forge",
    "build:create-streak-app": "npm run build -w packages/create-streak-app",
    "build:docs-site": "npm run build -w apps/docs-site",
    "lint": "bun run --filter 'streak-forge' --filter 'create-streak-app' lint",
    "test": "echo \"no tests configured yet\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valoriz/streak-forge.git"
  },
  "author": "indrajithc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/valoriz/streak-forge/issues"
  },
  "homepage": "https://github.com/valoriz/streak-forge#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
