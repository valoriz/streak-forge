{
  "name": "streak-forge",
  "version": "0.1.0-v2.2",
  "description": "streak-forge v2 (rewrite in progress) - stage 1: dev server only",
  "type": "module",
  "private": true,
  "bin": {
    "streak-forge": "./dist/cli/main.js"
  },
  "exports": {
    "./components": {
      "types": "./dist/src/components/index.d.ts",
      "import": "./dist/src/components/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/src/jsx/jsx-runtime.d.ts",
      "import": "./dist/src/jsx/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/src/jsx/jsx-dev-runtime.d.ts",
      "import": "./dist/src/jsx/jsx-dev-runtime.js"
    },
    "./core": {
      "types": "./dist/src/render.d.ts",
      "import": "./dist/src/render.js"
    }
  },
  "files": ["dist/**/*.js", "dist/**/*.d.ts"],
  "scripts": {
    "clean": "rm -rf dist",
    "build:js": "bun bun.build.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run clean && bun run build:js && bun run build:types",
    "dev": "echo 'run `streak-forge dev` from a consumer app instead'"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "dotenv": "^17.2.2",
    "node-html-parser": "^7.0.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21"
  }
}
